{
  "name": "@internetarchive/ia-book-actions",
  "description": "Bookreader actions for borrowable book",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/internetarchive/iaux-account-settings.git"
  },
  "author": "Internet Archive",
  "license": "AGPL-3.0-only",
  "version": "1.5.0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "web-dev-server",
    "build": "tsc",
    "prepare:ghpages": "rimraf ghpages && yarn run prepare && vite build",
    "prepare": "yarn run build && husky install",
    "lint": "eslint && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"index.ts\"",
    "format": "eslint --fix && prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"index.ts\"",
    "test": "yarn run lint && yarn test:fast --coverage",
    "test:fast": "web-test-runner",
    "test:watch": "web-test-runner --watch --playwright --browsers chromium firefox webkit",
    "deploy": "yarn run deploy:run -e $(git branch --show-current)",
    "deploy:run": "yarn run prepare:ghpages && touch ghpages/.nojekyll && yarn run deploy:gh",
    "deploy:gh": "gh-pages -t -d ghpages -m \"Build for $(git log --pretty=format:\"%h %an %ai %s\" -n1) [skip ci]\""
  },
  "dependencies": {
    "@internetarchive/icon-info": "^1.4.1",
    "@internetarchive/local-cache": "^0.2.1",
    "@internetarchive/modal-manager": "^2.0.0",
    "@internetarchive/shared-resize-observer": "^0.2.0",
    "install-deps": "^1.1.0",
    "lit": "^2.8.0 || ^3.3.2"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@types/node": "^25.3.0",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "sinon": "^13.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.10"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
